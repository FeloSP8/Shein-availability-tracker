# Copia este archivo a .env y rellena estos 3 datos.
#
# Activa la verificación en dos pasos en tu cuenta de Gmail y genera una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# (no uses tu contraseña normal de Gmail).

GMAIL_USER=tu_correo@gmail.com
GMAIL_APP_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_TO=correo_que_recibira_los_avisos@gmail.com
