# Copia este archivo a .env y rellena tus datos de correo.
# Con Gmail: activa la verificación en dos pasos y genera una "contraseña de
# aplicación" en https://myaccount.google.com/apppasswords (no uses tu
# contraseña normal).

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=tu_contraseña_de_aplicacion
EMAIL_FROM=tu_correo@gmail.com
EMAIL_TO=tu_correo@gmail.com
